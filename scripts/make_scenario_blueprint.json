        "designer": {
          "x": 0,
          "y": 0,
          "name": "Capture Practice Lead"
        },
        "expect": [
          { "name": "leadId", "type": "text", "label": "Lead ID" },
          { "name": "practiceName", "type": "text", "label": "Practice Name" },
          { "name": "contactName", "type": "text", "label": "Contact Name" },
          { "name": "email", "type": "email", "label": "Email" },
          { "name": "phone", "type": "text", "label": "Phone Number" },
          { "name": "city", "type": "text", "label": "City" },
          { "name": "procedureGoal", "type": "text", "label": "Procedure Goal" },
          { "name": "monthlyBudget", "type": "text", "label": "Monthly Budget" },
          { "name": "unlockPrice", "type": "text", "label": "Unlock Price" },
          { "name": "timestamp", "type": "date", "label": "Timestamp" },
          { "name": "source", "type": "text", "label": "Lead Source" }
        ]
      }
    },
    {
      "id": 2,
      "module": "email:ActionSendAnEmail",
      "version": 1,
      "parameters": {},
